# ─── Despliegue OCRI con docker compose (copiar a .env) ──────────────────────

# Base de datos
DB_NAME=ocri
DB_USER=ocri
DB_PASSWORD=cambiar-me-C3n1a.
DB_ROOT_PASSWORD=cambiar-me-R00t.

# Autenticación JWT (mínimo 32 caracteres).
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puertos públicos (el único a abrir en el firewall es el del frontend)
WEB_PORT=3000

# Orígenes frontend permitidos por CORS (separados por coma). Opcional si el
# frontend proxea el API por el mismo origen (caso Docker por defecto).
# FRONTEND_ORIGIN=https://ocri.uncp.edu.pe

# ─── Almacenamiento S3-compatible (Huawei OBS) ───────────────────────────────
# Opcional: si se omiten, los archivos viven solo en el volumen local del backend.
S3_BUCKET=otiuncp-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=LA-SANTIAGO
S3_ENDPOINT=https://obs.la-south-2.myhuaweicloud.com
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_TTL=300
S3_PREFIX=OCRI_convenios