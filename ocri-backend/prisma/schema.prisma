// ═══════════════════════════════════════════════════════════════════════════
// OCRI-UNCP · Sistema de Gestión de Convenios Internacionales
// Esquema alineado al flujo real de OCRI en 3 etapas:
//   E1 Propuesta   : recepción → opiniones de dependencias → expediente técnico
//                    → envío a Rectorado
//   E2 Registro    : decisión de Rectorado (suscribe / no suscribe) → convenio
//                    firmado → registro formal (semáforo activo) → publicación
//   E3 Seguimiento : plan de trabajo → informes semestrales/finales con loop
//                    de correcciones → conclusión del seguimiento
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Máquina de estados del proceso ─────────────────────────────────────────

enum process_status {
  RECEPCIONADA // E1: OCRI recibe la solicitud derivada por Rectorado
  OPINIONES_EN_CURSO // E1: oficios de solicitud de opinión generados/enviados
  OPINIONES_COMPLETAS // E1: todas las opiniones recibidas y coordinadas
  EXPEDIENTE_TECNICO_LISTO // E1: expediente técnico + informe/opinión OCRI elaborados
  ENVIADO_A_RECTORADO // E1 fin: expediente + propuesta + opinión remitidos
  NO_SUSCRITO // E2 terminal: Rectorado no suscribe; solicitante notificado
  SUSCRITO // E2: Rectorado suscribe y remite el convenio firmado
  REGISTRADO // E2: registrado con resolución, vigencia y responsables (semáforo activo)
  PUBLICADO // E2 fin: OCRI publicó el convenio
  EN_SEGUIMIENTO // E3: plan de trabajo solicitado a los responsables
  SEGUIMIENTO_CONCLUIDO // E3 terminal: todos los informes validados e inscritos
}

enum validity_status {
  PENDIENTE // aún no suscrito/registrado
  VIGENTE
  SUSPENDIDO
  RESCINDIDO
  VENCIDO
}

enum process_stage {
  ETAPA_1_PROPUESTA
  ETAPA_2_REGISTRO
  ETAPA_3_SEGUIMIENTO
}

enum user_role {
  admin
  editor
  viewer
}

enum document_direction {
  ENTRADA
  SALIDA
  INTERNO
}

enum opinion_request_status {
  GENERADA
  ENVIADA
  RESPONDIDA
  VALIDADA
  OBSERVADA
  CANCELADA
}

enum dependencia_kind {
  RECTORADO
  OCRI
  UNIDAD_ORGANICA
}

enum rectorate_decision_type {
  APPROVED // convenio suscrito
  REJECTED // convenio no suscrito
}

enum responsable_side {
  UNCP
  CONTRAPARTE
}

enum deliverable_type {
  PLAN_DE_TRABAJO
  INFORME_SEMESTRAL
  INFORME_FINAL
}

// Ciclo del entregable: solicitar → recibir → revisar (validar u observar con
// correcciones) → registrar. La re-remisión tras observación incrementa versión.
enum deliverable_status {
  SOLICITADO
  RECIBIDO
  OBSERVADO
  REGISTRADO
}

// ─── Usuarios y catálogos ────────────────────────────────────────────────────

model users {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  email      String    @unique(map: "users_email_unique") @db.VarChar(255)
  password   String    @db.VarChar(255)
  role       user_role @default(viewer)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  documents_uploaded       documents[]
  deliverable_observations deliverable_observations[]

  @@index([role])
}

model institutions {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  country    String    @db.VarChar(255)
  type       String    @default("Publica") @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  agreements agreements[]

  @@index([country], map: "institutions_country_index")
  @@index([name], map: "institutions_name_index")
  @@index([type], map: "institutions_type_index")
}

model agreement_types {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  agreements agreements[]
}

model dependencias {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  code               String           @unique @db.VarChar(30)
  name               String           @db.VarChar(255)
  kind               dependencia_kind
  email              String?          @db.VarChar(255)
  is_default_opinion Boolean          @default(false)
  sort_order         Int              @default(0)
  is_active          Boolean          @default(true)
  created_at         DateTime?        @db.Timestamp(0)
  updated_at         DateTime?        @db.Timestamp(0)

  opinion_requests opinion_requests[]

  @@index([is_active])
}

model document_types {
  id        BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  code      String             @unique @db.VarChar(50)
  name      String             @db.VarChar(255)
  direction document_direction
  is_active Boolean            @default(true)

  documents documents[]
}

// ─── Entidad principal: Convenio / Trámite ──────────────────────────────────

model agreements {
  id           BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  tramite_code String  @unique @db.VarChar(30)
  title        String  @db.VarChar(510)
  name         String? @db.VarChar(500) // objeto/denominación completa

  // Solicitud (E1): entidad que propuso el convenio y su derivación por Rectorado
  applicant_name          String? @db.VarChar(255)
  applicant_email         String? @db.VarChar(255)
  applicant_unit          String? @db.VarChar(255) // unidad orgánica solicitante
  rectorate_oficio_number String? @db.VarChar(80) // oficio con que Rectorado deriva a OCRI

  institution_id    BigInt @db.UnsignedBigInt
  agreement_type_id BigInt @db.UnsignedBigInt

  // Registro (E2)
  resolution_number String?   @unique(map: "agreements_resolution_number_unique") @db.VarChar(255)
  start_date        DateTime? @db.Date
  end_date          DateTime? @db.Date
  drive_link        String?   @db.VarChar(500) // repositorio institucional

  // Estado del proceso
  process_status  process_status  @default(RECEPCIONADA)
  validity_status validity_status @default(PENDIENTE)
  stage           process_stage   @default(ETAPA_1_PROPUESTA)

  // Decisión de Rectorado (E2)
  rectorate_decision      rectorate_decision_type?
  rectorate_decision_at   DateTime?                @db.Timestamp(0)
  notified_solicitante_at DateTime?                @db.Timestamp(0) // notificación de rechazo a la entidad

  // Hitos
  published_at            DateTime? @db.Timestamp(0)
  registered_at           DateTime? @db.Timestamp(0)
  monitoring_concluded_at DateTime? @db.Timestamp(0)

  observations String?   @db.Text
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)

  institutions    institutions    @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "agreements_institution_id_foreign")
  agreement_types agreement_types @relation(fields: [agreement_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "agreements_agreement_type_id_foreign")

  documents        documents[]
  opinion_requests opinion_requests[]
  process_events   process_events[]
  deliverables     deliverables[]
  responsables     agreement_responsables[]

  @@index([agreement_type_id], map: "agreements_agreement_type_id_foreign")
  @@index([end_date], map: "agreements_end_date_index")
  @@index([institution_id], map: "agreements_institution_id_foreign")
  @@index([start_date], map: "agreements_start_date_index")
  @@index([process_status])
  @@index([validity_status])
}

// Responsables del convenio registrados durante el registro (E2); destinatarios
// del Plan de Trabajo y de los informes (E3). Solo OCRI opera el sistema.
model agreement_responsables {
  id           BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  agreement_id BigInt           @db.UnsignedBigInt
  name         String           @db.VarChar(255)
  role         String?          @db.VarChar(150)
  side         responsable_side @default(UNCP)
  email        String?          @db.VarChar(255)
  phone        String?          @db.VarChar(50)
  created_at   DateTime?        @db.Timestamp(0)
  updated_at   DateTime?        @db.Timestamp(0)

  agreements agreements @relation(fields: [agreement_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "agreement_responsables_agreement_id_foreign")

  @@index([agreement_id])
}

// ─── Documentos (repositorio único del expediente) ──────────────────────────

model documents {
  id            BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  agreement_id  BigInt  @db.UnsignedBigInt
  name          String  @db.VarChar(255)
  file_path     String  @db.VarChar(255)
  original_name String? @db.VarChar(255)
  extension     String? @db.VarChar(10)

  document_type_id   BigInt?             @db.UnsignedBigInt
  direction          document_direction?
  stage              process_stage?
  opinion_request_id BigInt?             @db.UnsignedBigInt
  deliverable_id     BigInt?             @db.UnsignedBigInt
  uploaded_by_id     BigInt?             @db.UnsignedBigInt
  created_at         DateTime?           @db.Timestamp(0)
  updated_at         DateTime?           @db.Timestamp(0)

  agreements       agreements        @relation(fields: [agreement_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "documents_agreement_id_foreign")
  document_types   document_types?   @relation(fields: [document_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opinion_requests opinion_requests? @relation(fields: [opinion_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deliverables     deliverables?     @relation(fields: [deliverable_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploaded_by      users?            @relation(fields: [uploaded_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([agreement_id], map: "documents_agreement_id_foreign")
  @@index([document_type_id])
  @@index([opinion_request_id])
  @@index([deliverable_id])
  @@index([agreement_id, stage])
}

// ─── E1: Solicitudes de opinión a dependencias ──────────────────────────────

model opinion_requests {
  id             BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  agreement_id   BigInt                 @db.UnsignedBigInt
  dependencia_id BigInt                 @db.UnsignedBigInt
  stage          process_stage          @default(ETAPA_1_PROPUESTA)
  status         opinion_request_status @default(GENERADA)

  oficio_number String?   @db.VarChar(80)
  directed_to   String?   @db.VarChar(255)
  sent_via      String?   @db.VarChar(20)
  adesa_number  String?   @db.VarChar(80)
  sent_at       DateTime? @db.Timestamp(0)
  due_at        DateTime? @db.Date
  response_date DateTime? @db.Date
  validated_at  DateTime? @db.Timestamp(0)
  observations  String?   @db.Text
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)

  agreements   agreements   @relation(fields: [agreement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dependencias dependencias @relation(fields: [dependencia_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents    documents[]

  @@unique([agreement_id, dependencia_id, stage])
  @@index([agreement_id])
  @@index([response_date])
  @@index([status, due_at])
  @@index([dependencia_id])
}

// ─── Auditoría del proceso ──────────────────────────────────────────────────

model process_events {
  id                 BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  agreement_id       BigInt         @db.UnsignedBigInt
  opinion_request_id BigInt?        @db.UnsignedBigInt
  stage              process_stage?
  event_type         String         @db.VarChar(60)
  description        String?        @db.VarChar(500)
  actor_user_id      BigInt?        @db.UnsignedBigInt
  from_value         String?        @db.VarChar(60)
  to_value           String?        @db.VarChar(60)
  occurred_at        DateTime       @default(now()) @db.Timestamp(0)
  metadata           Json?

  agreements agreements @relation(fields: [agreement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agreement_id, occurred_at])
}

// ─── E3: Plan de trabajo e informes ────────────────────────────────────────

model deliverables {
  id           BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  agreement_id BigInt             @db.UnsignedBigInt
  type         deliverable_type
  title        String             @db.VarChar(255)
  status       deliverable_status @default(SOLICITADO)
  period       String?            @db.VarChar(50)
  version      Int                @default(1)

  requested_at  DateTime  @default(now()) @db.Timestamp(0)
  submitted_at  DateTime? @db.Timestamp(0)
  registered_at DateTime? @db.Timestamp(0)
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_at    DateTime  @updatedAt @db.Timestamp(0)

  agreements   agreements                 @relation(fields: [agreement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  observations deliverable_observations[]
  documents    documents[]

  @@index([agreement_id])
  @@index([agreement_id, type])
  @@index([status])
}

model deliverable_observations {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  deliverable_id BigInt   @db.UnsignedBigInt
  comment        String   @db.Text
  created_by_id  BigInt?  @db.UnsignedBigInt
  created_at     DateTime @default(now()) @db.Timestamp(0)

  deliverable deliverables @relation(fields: [deliverable_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by  users?       @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([deliverable_id])
}

// ─── Configuración ──────────────────────────────────────────────────────────

model app_config {
  key        String    @id @db.VarChar(80)
  value      String    @db.VarChar(255)
  updated_at DateTime? @db.Timestamp(0)
}
