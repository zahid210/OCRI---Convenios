# ─── Base de datos (MariaDB) ─────────────────────────────────────────────────
# URL de conexión (driver mariadb). Ejemplo:
# DATABASE_URL=mariadb://usuario:password@host:3306/ocri
DATABASE_URL=

# Piscina de conexiones MaríaDB
# DB_POOL_MAX=20

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Secreto JWT (mínimo 32 caracteres). Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origen(es) permitidos por CORS (separados por coma). Si se omite, se usan
# localhost:3001 por defecto.
# FRONTEND_ORIGIN=https://ocri.dominio.gob.pe

# ─── Servidor ─────────────────────────────────────────────────────────────────
# Puerto HTTP del backend (por defecto 3000).
# PORT=3000

# ─── Almacenamiento S3-compatible (Huawei OBS) ────────────────────────────────
# Si S3_BUCKET, credenciales y endpoint están definidos, los documentos se
# persisten en el bucket bajo S3_PREFIX/ y se sirven con URLs prefirmadas.
# Si se omiten, el sistema funciona con el almacenamiento local (uploads/).
S3_BUCKET=otiuncp-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=LA-SANTIAGO
S3_ENDPOINT=https://obs.la-south-2.myhuaweicloud.com
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_TTL=300
S3_PREFIX=OCRI_convenios

# ─── Seeds / migraciones ─────────────────────────────────────────────────────
# Ruta con los PDFs de los convenios históricos (para seed:historico).
# HISTORIC_PDFS_ROOT=/home/mato5/Documents/pdfs