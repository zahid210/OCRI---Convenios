# Dependencias
node_modules/

# Archivos de entorno
.env
.env.local
.env.*.local

# Archivos generados
.next/
dist/
out/
coverage/

# Configuración local de WebStorm
.idea/

# Archivos del sistema
.DS_Store
Thumbs.db

# PDFs transaccionales subidos por los convenios (se generan por cada trámite)
# Se ignoran los archivos sueltos de uploads/, pero se conservan versionados
# los templates y sus assets (logos y plantilla del oficio).
ocri-backend/uploads/*
!ocri-backend/uploads/templates/

# Volcados y respaldos de base de datos (nunca versionar dumps con datos sensibles;
# solo se versionan las migraciones de esquema de Prisma).
*.sql
*.sql.gz
*.dump
*.bak
!ocri-backend/prisma/migrations/**/*.sql
